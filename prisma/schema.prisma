// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Merchant / Loja ───────────────────────────────────────────────
model Merchant {
  id        String              @id @default(cuid())
  ref       String              @unique                // Internal merchant reference
  name      String              @map("store_name")     // Store name (visible on checkout)
  logoUrl   String?             @map("logo_url")       // Store logo URL (visible on checkout)
  webhookUrl String?            @map("webhook_url")    // Merchant webhook for CRM
  apiKey    String              @unique @map("api_key") // API key for merchant authentication
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  checkouts CheckoutSession[]

  @@map("merchants")
}

// ─── Checkout Session (Encomenda) ──────────────────────────────────
model CheckoutSession {
  id                String       @id @default(cuid())
  ref               String       @unique                 // Order reference (visible in URL)
  merchantRef       String       @map("merchant_ref")     // Merchant internal reference
  merchantId        String       @map("merchant_id")
  merchant          Merchant     @relation(fields: [merchantId], references: [id])

  // Order details (visible on checkout)
  productName       String       @map("product_name")
  productDesc       String?      @map("product_desc")
  amount            Int          // Amount in cents (e.g., 3000 = €30.00)
  currency          String       @default("EUR")  // EUR or USD

  // Session metadata
  locale            String       @default("pt")   // Default language
  status            String       @default("pending") // pending | collecting_data | processing | paid | failed | expired | cancelled
  expiresAt         DateTime?    @map("expires_at")
  paidAt            DateTime?    @map("paid_at")
  cancelledAt       DateTime?    @map("cancelled_at")

  // Stripe Payment Intent (embedded checkout)
  paymentIntentId   String?      @map("payment_intent_id")
  stripeClientSecret String?     @map("stripe_client_secret")

  // Legacy: Stripe Crypto Onramp (kept for Phase 2 treasury)
  stripeSessionId   String?      @map("stripe_session_id")
  stripeRedirectUrl String?      @map("stripe_redirect_url")

  // Customer data (KYC L1/L2 compliant)
  customerEmail     String?      @map("customer_email")
  customerPhone     String?      @map("customer_phone")
  customerFirstName String?      @map("customer_first_name")
  customerLastName  String?      @map("customer_last_name")
  customerDob       String?      @map("customer_dob")      // YYYY-MM-DD
  customerCountry   String?      @map("customer_country")   // ISO 3166-1 alpha-2
  customerAddress1  String?      @map("customer_address_1")
  customerAddress2  String?      @map("customer_address_2")
  customerCity      String?      @map("customer_city")
  customerZip       String?      @map("customer_zip")
  customerState     String?      @map("customer_state")     // State/Province

  // Pre-KYC L1 Declarative
  preKycStatus           String    @default("pending") @map("pre_kyc_status")     // pending | approved | rejected
  preKycL1RejectedReason String?   @map("pre_kyc_l1_rejected_reason")           // JSON array of error codes
  preKycL1ApprovedAt     DateTime? @map("pre_kyc_l1_approved_at")
  declarationAccepted    Boolean   @default(false) @map("declaration_accepted")
  declarationTextVersion String?   @map("declaration_text_version")              // e.g. "1.0"

  // Atlas CRM forwarding
  crmForwarded      Boolean      @default(false) @map("crm_forwarded")
  crmForwardedAt    DateTime?    @map("crm_forwarded_at")

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("checkout_sessions")
}

// ─── Audit Log ─────────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(cuid())
  sessionId   String?  @map("session_id")
  action      String                                   // created | updated | paid | webhook_received | crm_forwarded
  metadata    String?                                  // JSON string with additional data
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ─── Stripe Webhook Idempotency ────────────────────────────────────
model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  status        String   @default("processed") // processed | failed
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("webhook_events")
}
