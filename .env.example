# ─── Atlas Payments Checkout ──────────────────────────────────────────
# Copy this file to .env.local and fill in the values.

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL="file:./db/custom.db"

# ─── Stripe (Required for live payments) ─────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ─── Treasury Wallet ────────────────────────────────────────────────
# Atlas Ethereum wallet address that receives USDC settlements
ATLAS_TREASURY_WALLET="0x..."

# ─── Atlas CRM (Phase 2 — optional) ────────────────────────────────
ATLAS_CRM_WEBHOOK_URL="https://api.atlasglobal.digital/api/v1/crm/checkout"
ATLAS_API_KEY=""

# ─── Admin ───────────────────────────────────────────────────────────
# Required for POST /api/merchant/register
ADMIN_API_KEY=""

# ─── Application ────────────────────────────────────────────────────
# Base URL used for redirect URLs (return_url, cancel_url)
NEXT_PUBLIC_BASE_URL="https://checkout.atlasglobal.digital"
